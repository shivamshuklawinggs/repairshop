<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Accounts Payable Detail</title>
    <style>
        body {
            margin: 0;
            padding: 20px;
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #111827;
            font-size: 14px;
        }
        .container {
            max-width: 1400px;
            margin: 0 auto;
            background: #ffffff;
        }
        .header {
            text-align: center;
            padding: 20px;
            border-bottom: 3px solid #003bff;
        }
        .company-name {
            font-size: 24px;
            font-weight: 700;
            color: #003bff;
            margin-bottom: 5px;
        }
        .report-title {
            font-size: 20px;
            font-weight: 600;
            color: #111827;
            margin: 10px 0 5px 0;
        }
        .date-range {
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 10px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th {
            background-color: #003bff;
            color: #ffffff;
            padding: 12px;
            text-align: center;
            font-weight: 500;
            font-size: 14px;
        }
        th:first-child {
            text-align: left;
        }
        td {
            padding: 10px 12px;
            border-bottom: 1px solid #e5e7eb;
            text-align: center;
        }
        td:first-child {
            text-align: left;
        }
        .bucket-header {
            font-weight: 600;
            background-color: #ffffff;
            font-size: 14px;
        }
        .bucket-header td {
            padding: 12px;
        }
        .subtotal-row {
            background-color: #e4ecfd;
            font-weight: 600;
            font-size: 15px;
        }
        .total-row {
            background-color: #003bff;
            color: #ffffff;
            font-weight: 600;
            font-size: 15px;
        }
        .total-row td {
            border-bottom: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="company-name"><%= companyName %></div>
            <div class="report-title">Accounts Payable Detail</div>
            <div class="date-range"><%= dateRange %></div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Transaction Type</th>
                    <th>Num</th>
                    <th>Vendor Display Name</th>
                    <th>Due Date</th>
                    <th>Past Due</th>
                    <th>Amount</th>
                    <th>Open Balance</th>
                </tr>
            </thead>
            <tbody>
                <% if (data && data.length > 0) { %>
                    <% data.forEach(group => { %>
                        <!-- Bucket Header -->
                        <tr class="bucket-header">
                            <td colspan="8"><strong><%= group.bucketLabel %> (<%= group.invoices.length %>)</strong></td>
                        </tr>

                        <!-- Bills -->
                        <% group.invoices.forEach(invoice => { %>
                            <tr>
                                <td><%= invoice.date || '-' %></td>
                                <td>Bill</td>
                                <td><%= invoice.num || '-' %></td>
                                <td><%= invoice.vendorDisplayName || '-' %></td>
                                <td><%= invoice.dueDate || '-' %></td>
                                <td><%= invoice.daysPastDue || 0 %></td>
                                <td>$<%= (invoice.amount || 0).toFixed(2) %></td>
                                <td>$<%= (invoice.openBalance || 0).toFixed(2) %></td>
                            </tr>
                        <% }); %>

                        <!-- Subtotal -->
                        <tr class="subtotal-row">
                            <td colspan="6">Total for <%= group.bucketLabel %></td>
                            <td>$<%= (group.totalAmount || 0).toFixed(2) %></td>
                            <td>$<%= (group.totalOpenBalance || 0).toFixed(2) %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 20px; color: #6b7280;">No records found</td>
                    </tr>
                <% } %>

                <!-- Grand Total -->
                <tr class="total-row">
                    <td colspan="6">Total</td>
                    <td>$<%= (totalAmountWithTax || 0).toFixed(2) %></td>
                    <td>$<%= (totalDueAmount || 0).toFixed(2) %></td>
                </tr>
            </tbody>
        </table>
    </div>
</body>
</html>
