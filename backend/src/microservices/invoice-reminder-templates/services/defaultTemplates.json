[
  {
    "templateType": "before",
    "name": "Default Before Due Date",
    "subject": "Invoice {{invoiceNumber}} - Due in {{days}} days",
    "htmlContent": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Invoice Reminder</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            line-height: 1.6;\n            color: #333;\n            max-width: 600px;\n            margin: 0 auto;\n            padding: 20px;\n        }\n        .header {\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n            padding: 20px;\n            text-align: center;\n            border-radius: 10px 10px 0 0;\n        }\n        .content {\n            background: #f9f9f9;\n            padding: 30px;\n            border-radius: 0 0 10px 10px;\n            box-shadow: 0 4px 6px rgba(0,0,0,0.1);\n        }\n        .invoice-details {\n            background: white;\n            padding: 20px;\n            border-radius: 5px;\n            margin: 20px 0;\n            border-left: 4px solid #667eea;\n        }\n        .amount {\n            font-size: 24px;\n            font-weight: bold;\n            color: #667eea;\n            text-align: center;\n            margin: 20px 0;\n        }\n        .due-date {\n            background: #fff3cd;\n            color: #856404;\n            padding: 15px;\n            border-radius: 5px;\n            text-align: center;\n            margin: 20px 0;\n        }\n        .footer {\n            text-align: center;\n            margin-top: 30px;\n            color: #666;\n            font-size: 12px;\n        }\n        .button {\n            display: inline-block;\n            background: #667eea;\n            color: white;\n            padding: 12px 30px;\n            text-decoration: none;\n            border-radius: 5px;\n            margin: 20px 0;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"header\">\n        <h1>Invoice Reminder</h1>\n        <p>Payment Due Soon</p>\n    </div>\n    <div class=\"content\">\n        <p>Dear {{customerName}},</p>\n        <p>This is a friendly reminder that invoice <strong>{{invoiceNumber}}</strong> is due in <strong>{{days}} days</strong>.</p>\n        \n        <div class=\"invoice-details\">\n            <p><strong>Invoice Number:</strong> {{invoiceNumber}}</p>\n            <p><strong>Invoice Date:</strong> {{invoiceDate}}</p>\n            <p><strong>Due Date:</strong> {{dueDate}}</p>\n        </div>\n        \n        <div class=\"amount\">\n            Amount Due: {{amount}}\n        </div>\n        \n        <div class=\"due-date\">\n            <strong>⏰ Due in {{days}} days</strong>\n        </div>\n        \n        <p>Please ensure payment is made by the due date to avoid any late fees. If you have already made the payment, please disregard this notice.</p>\n        \n        <div style=\"text-align: center;\">\n            <a href=\"{{paymentLink}}\" class=\"button\">Pay Now</a>\n        </div>\n        \n        <p>If you have any questions or concerns, please don't hesitate to contact us.</p>\n        \n        <p>Thank you for your business!</p>\n        \n        <div class=\"footer\">\n            <p>{{companyName}}</p>\n            <p>{{companyAddress}}</p>\n            <p>Email: {{companyEmail}} | Phone: {{companyPhone}}</p>\n        </div>\n    </div>\n</body>\n</html>",
    "daysBeforeDue": 7,
    "frequency": "once",
    "customIntervalDays": 1,
    "maxReminders": 3,
    "sendTime": "09:00"
  },
  {
    "templateType": "on_due",
    "name": "Default On Due Date",
    "subject": "Invoice {{invoiceNumber}} - Due Today",
    "htmlContent": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Invoice Due Today</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            line-height: 1.6;\n            color: #333;\n            max-width: 600px;\n            margin: 0 auto;\n            padding: 20px;\n        }\n        .header {\n            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);\n            color: white;\n            padding: 20px;\n            text-align: center;\n            border-radius: 10px 10px 0 0;\n        }\n        .content {\n            background: #f9f9f9;\n            padding: 30px;\n            border-radius: 0 0 10px 10px;\n            box-shadow: 0 4px 6px rgba(0,0,0,0.1);\n        }\n        .invoice-details {\n            background: white;\n            padding: 20px;\n            border-radius: 5px;\n            margin: 20px 0;\n            border-left: 4px solid #f5576c;\n        }\n        .amount {\n            font-size: 24px;\n            font-weight: bold;\n            color: #f5576c;\n            text-align: center;\n            margin: 20px 0;\n        }\n        .due-date {\n            background: #f8d7da;\n            color: #721c24;\n            padding: 15px;\n            border-radius: 5px;\n            text-align: center;\n            margin: 20px 0;\n            border: 2px solid #f5c6cb;\n        }\n        .footer {\n            text-align: center;\n            margin-top: 30px;\n            color: #666;\n            font-size: 12px;\n        }\n        .button {\n            display: inline-block;\n            background: #f5576c;\n            color: white;\n            padding: 12px 30px;\n            text-decoration: none;\n            border-radius: 5px;\n            margin: 20px 0;\n        }\n        .urgent {\n            color: #f5576c;\n            font-weight: bold;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"header\">\n        <h1>⚠️ Invoice Due Today</h1>\n        <p>Immediate Action Required</p>\n    </div>\n    <div class=\"content\">\n        <p>Dear {{customerName}},</p>\n        <p class=\"urgent\">This is an urgent reminder that invoice <strong>{{invoiceNumber}}</strong> is <strong>DUE TODAY</strong>.</p>\n        \n        <div class=\"invoice-details\">\n            <p><strong>Invoice Number:</strong> {{invoiceNumber}}</p>\n            <p><strong>Invoice Date:</strong> {{invoiceDate}}</p>\n            <p><strong>Due Date:</strong> {{dueDate}}</p>\n        </div>\n        \n        <div class=\"amount\">\n            Amount Due: {{amount}}\n        </div>\n        \n        <div class=\"due-date\">\n            <strong>🚨 DUE TODAY - Please arrange payment immediately</strong>\n        </div>\n        \n        <p>Please ensure payment is made today to avoid any late fees or service interruptions. If you have already made the payment, please disregard this notice.</p>\n        \n        <div style=\"text-align: center;\">\n            <a href=\"{{paymentLink}}\" class=\"button\">Pay Now</a>\n        </div>\n        \n        <p>If you have any questions or concerns, please don't hesitate to contact us immediately.</p>\n        \n        <p>Thank you for your prompt attention to this matter.</p>\n        \n        <div class=\"footer\">\n            <p>{{companyName}}</p>\n            <p>{{companyAddress}}</p>\n            <p>Email: {{companyEmail}} | Phone: {{companyPhone}}</p>\n        </div>\n    </div>\n</body>\n</html>",
    "frequency": "once",
    "customIntervalDays": 1,
    "maxReminders": 1,
    "sendTime": "09:00"
  },
  {
    "templateType": "after",
    "name": "Default After Due Date",
    "subject": "Invoice {{invoiceNumber}} - Overdue by {{days}} days",
    "htmlContent": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Invoice Overdue Notice</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            line-height: 1.6;\n            color: #333;\n            max-width: 600px;\n            margin: 0 auto;\n            padding: 20px;\n        }\n        .header {\n            background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%);\n            color: white;\n            padding: 20px;\n            text-align: center;\n            border-radius: 10px 10px 0 0;\n        }\n        .content {\n            background: #f9f9f9;\n            padding: 30px;\n            border-radius: 0 0 10px 10px;\n            box-shadow: 0 4px 6px rgba(0,0,0,0.1);\n        }\n        .invoice-details {\n            background: white;\n            padding: 20px;\n            border-radius: 5px;\n            margin: 20px 0;\n            border-left: 4px solid #eb3349;\n        }\n        .amount {\n            font-size: 24px;\n            font-weight: bold;\n            color: #eb3349;\n            text-align: center;\n            margin: 20px 0;\n        }\n        .overdue-notice {\n            background: #f8d7da;\n            color: #721c24;\n            padding: 15px;\n            border-radius: 5px;\n            text-align: center;\n            margin: 20px 0;\n            border: 2px solid #f5c6cb;\n        }\n        .footer {\n            text-align: center;\n            margin-top: 30px;\n            color: #666;\n            font-size: 12px;\n        }\n        .button {\n            display: inline-block;\n            background: #eb3349;\n            color: white;\n            padding: 12px 30px;\n            text-decoration: none;\n            border-radius: 5px;\n            margin: 20px 0;\n        }\n        .urgent {\n            color: #eb3349;\n            font-weight: bold;\n        }\n        .warning {\n            background: #fff3cd;\n            color: #856404;\n            padding: 10px;\n            border-radius: 5px;\n            margin: 15px 0;\n            border-left: 4px solid #ffc107;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"header\">\n        <h1>🚨 Invoice Overdue</h1>\n        <p>Immediate Action Required</p>\n    </div>\n    <div class=\"content\">\n        <p>Dear {{customerName}},</p>\n        <p class=\"urgent\">This is an urgent notice that invoice <strong>{{invoiceNumber}}</strong> is <strong>OVERDUE by {{days}} days</strong>.</p>\n        \n        <div class=\"invoice-details\">\n            <p><strong>Invoice Number:</strong> {{invoiceNumber}}</p>\n            <p><strong>Invoice Date:</strong> {{invoiceDate}}</p>\n            <p><strong>Due Date:</strong> {{dueDate}}</p>\n            <p><strong>Days Overdue:</strong> {{days}}</p>\n        </div>\n        \n        <div class=\"amount\">\n            Amount Due: {{amount}}\n        </div>\n        \n        <div class=\"overdue-notice\">\n            <strong>⚠️ OVERDUE BY {{days}} DAYS - Immediate payment required</strong>\n        </div>\n        \n        <div class=\"warning\">\n            <strong>⚠️ Important:</strong> Late payment may result in additional fees, service interruptions, or impact on your account status.\n        </div>\n        \n        <p>Please arrange payment immediately to resolve this overdue invoice. If you have already made the payment, please provide payment confirmation so we can update our records.</p>\n        \n        <div style=\"text-align: center;\">\n            <a href=\"{{paymentLink}}\" class=\"button\">Pay Now</a>\n        </div>\n        \n        <p>If you are experiencing any issues or have questions about this invoice, please contact us immediately to discuss payment arrangements.</p>\n        \n        <p>We value your business and want to resolve this matter promptly.</p>\n        \n        <div class=\"footer\">\n            <p>{{companyName}}</p>\n            <p>{{companyAddress}}</p>\n            <p>Email: {{companyEmail}} | Phone: {{companyPhone}}</p>\n        </div>\n    </div>\n</body>\n</html>",
    "daysAfterDue": 1,
    "frequency": "daily",
    "customIntervalDays": 1,
    "maxReminders": 5,
    "sendTime": "09:00"
  }
]