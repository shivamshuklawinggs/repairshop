<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>FreightBooks Invoice</title>
  <% const brandColor = (invoice && invoice.companyId && invoice.companyId.color) || '#003bff'; %>
</head>
<body style="margin:0;padding:20px;background:#f3f6fb;font-family:Segoe UI,Arial,sans-serif;color:#111827;font-size: 14px;">
    <!-- MAIN CONTAINER -->
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:900px;margin:auto;background:#ffffff;border-radius:0px;overflow:hidden;border:1px solid #e5e7eb;">
      <!-- TOP BAR -->
      <tr>
        <td style="height:5px;background:<%= brandColor %>;"></td>
      </tr>
      <!-- HEADER -->
      <tr>
        <td style="padding:25px 40px;background:#ffffff;">
          <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <!-- LEFT -->
              <td valign="top">
                <div style="font-size:24px;font-weight:700;color:<%= brandColor %>;">
                  <%= invoice?.companyId?.label || 'FreightBooks' %>
                </div>
                <div style="margin-top:10px;font-size:14px;color:#6b7280;line-height:20px;">
                  <% if (invoice?.companyId?.address) { %><%= invoice.companyId.address %><br /><% } %>
                  <% if (invoice?.companyId?.phone) { %><%= invoice.companyId.phone %><br /><% } %>
                  <% if (invoice?.companyId?.email) { %><%= invoice.companyId.email %><% } %>
                </div>
              </td>
              <!-- RIGHT -->
              <td align="right" valign="top">
                <div style="font-size:32px;font-weight:700;color:#e0e7ff;letter-spacing:2px;text-transform:uppercase;">
                  Invoice
                </div>
                <div style="margin-top:5px;font-size:14px;color:#374151;line-height:22px;">
                  <strong>Invoice #:</strong> <%= invoice.invoiceNumber %><br>
                  <strong>Date:</strong> <%= formatDate(invoice.invoiceDate) %><br>
                  <strong>Due Date:</strong> <%= formatDate(invoice.dueDate) %><br>
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      <!-- Bill To -->
      <tr>
        <td style="padding:20px 40px 30px 40px;background:#ffffff;">
          <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <!-- BILL TO -->
              <td width="60%" valign="top"
                style="
                background:#ffffff;
                border:1px solid #dbe4ff;
                border-left:4px solid <%= brandColor %>;
                border-radius:15px;
                padding:15px 20px;
                ">
                <!-- TITLE -->
                <div style="
                  font-size:14px;
                  font-weight:700;
                  color:<%= brandColor %>;
                  text-transform:uppercase;
                  letter-spacing:1px;
                  margin-bottom:7px;
                  ">
                  Bill To 
                </div>
                <!-- COMPANY -->
                <div style="
                  font-size:16px;
                  font-weight:700;
                  color:#111827;
                  margin-bottom:5px;
                  line-height:1;
                  ">
                  <%= customer?.companyId?.label || 'N/A' %>
                </div>
                <!-- ADDRESS -->
                <div style="
                  font-size:15px;
                  font-weight:600;
                  color:#6b7280;
                  line-height:22px;
                  ">
                  <%= customer?.billingAddress?.address || '' %>
                  <% if (customer?.billingAddress?.city || customer?.billingAddress?.state) { %>
                    <br /><%= [customer?.billingAddress?.city, customer?.billingAddress?.state, customer?.billingAddress?.zipCode].filter(Boolean).join(', ') %>
                  <% } %>
                </div>
                <% if (customer?.phone) { %>
                <div style="
                  background:#eef2ff;
                  color:<%= brandColor %>;
                  padding:6px 15px;
                  border-radius:30px;
                  font-size:15px;
                  font-weight:700;
                  display: block;
                  margin-top: 10px;
                  ">
                  Ph: <%= customer.phone %>
                </div>
                <% } %>
                <% if (customer?.email) { %>
                <div style="
                  background:#f3f4f6;
                  color:#374151;
                  padding:6px 15px;
                  border-radius:30px;
                  font-size:14px;
                  font-weight:600;
                  display: block;
                  margin-top: 10px;
                  ">
                  Email: <%= customer.email %>
                </div>
                <% } %>
              </td>
              <td width="3%"></td>
              <!-- PAYMENT DETAILS -->
              <td width="30%" valign="top"
                style="
                background:linear-gradient(135deg,<%= brandColor %> 0%,#1d4ed8 100%);
                border-radius:15px;
                padding:18px;
                ">
                <!-- TITLE -->
                <div style="
                  font-size:12px;
                  font-weight:700;
                  color:#c7d2fe;
                  text-transform:uppercase;
                  letter-spacing:1px;
                  margin-bottom:10px;
                  ">
                  Payment Details
                </div>
                <!-- METHOD -->
                <div style="
                  background:rgba(255,255,255,0.12);
                  border:1px solid rgba(255,255,255,0.15);
                  border-radius:14px;
                  padding:10px 15px;
                  ">
                  <div style="
                    font-size:12px;
                    font-weight:700;
                    color:#c7d2fe;
                    text-transform:uppercase;
                    letter-spacing:1px;
                    margin-bottom:5px;
                    ">
                    Payment Method
                  </div>
                  <div style="
                    font-size:15px;
                    font-weight:700;
                    color:#ffffff;
                    margin-bottom:5px;
                    line-height:1;
                    ">
                    <%= invoice.paymentOptions || 'Bank Transfer' %>
                  </div>
                  <!-- TERMS -->
                  <table width="100%" cellpadding="0" cellspacing="0">
                    <tr>
                      <td style="
                        padding:3px 0;
                        color:#c7d2fe;
                        font-size:13px;
                        font-weight:700;
                        ">
                        Invoice Total :
                      </td>
                      <td align="right" style="
                        padding:3px 0;
                        color:#ffffff;
                        font-size:16px;
                        font-weight:700;
                        ">
                        $<%= total.toFixed(2) %>
                      </td>
                    </tr>
                    <tr>
                      <td style="
                        padding:3px 0;
                        color:#c7d2fe;
                        font-size:13px;
                        font-weight:700;
                        ">
                        Amount Paid :
                      </td>
                      <td align="right" style="
                        padding:3px 0;
                        color:#ffffff;
                        font-size:16px;
                        font-weight:700;
                        ">
                        $<%= recievedAmount.toFixed(2) %>
                      </td>
                    </tr>
                    <tr>
                      <td style="
                        padding:3px 0;
                        color:#c7d2fe;
                        font-size:13px;
                        font-weight:700;
                        ">
                        Balance Due :
                      </td>
                      <td align="right" style="
                        padding:3px 0;
                        color:#ffffff;
                        font-size:16px;
                        font-weight:700;
                        ">
                        $<%= balanceDue.toFixed(2) %>
                      </td>
                    </tr>
                  </table>
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <% if (load) { %>
      <!-- LOAD INFO + CARRIER -->
      <tr>
        <td style="padding:0 40px 20px 40px;">
          <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <!-- LOAD INFO -->
              <td width="49%" valign="top" style="background:#ffffff;border:1px solid #e5e7eb;border-radius:16px;padding:10px 20px;">
                <div style="font-size:13px;font-weight:700;color:<%= brandColor %>;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:5px;">
                  Load Information
                </div>
                <table width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td style="padding:3px 0;color:#6b7280;font-weight:600;">Commodity</td>
                    <td align="right" style="padding:3px 0;font-weight:600;"><%= load.commodity || 'N/A' %></td>
                  </tr>
                  <tr>
                    <td style="padding:3px 0;color:#6b7280;font-weight:600;">Equipment</td>
                    <td align="right" style="padding:3px 0;font-weight:600;"><%= load.equipmentType || 'N/A' %> - <%= load.equipmentLength || 'N/A' %>'</td>
                  </tr>
                  <tr>
                    <td style="padding:3px 0;color:#6b7280;font-weight:600;">Load Size</td>
                    <td align="right" style="padding:3px 0;font-weight:600;"><%= load.loadSize || 'N/A' %></td>
                  </tr>
                  <tr>
                    <td style="padding:3px 0;color:#6b7280;font-weight:600;">Weight</td>
                    <td align="right" style="padding:3px 0;font-weight:600;"><%= load.weight || 'N/A' %> lbs</td>
                  </tr>
                  <% if (load.temperature) { %>
                  <tr>
                    <td style="padding:3px 0;color:#6b7280;font-weight:600;">Temperature</td>
                    <td align="right" style="padding:3px 0;font-weight:600;"><%= load.temperature %>°<%= load.temperatureUnit %></td>
                  </tr>
                  <% } %>
                  <tr>
                    <td style="padding:3px 0;color:#6b7280;font-weight:600;">Declared Value</td>
                    <td align="right" style="padding:3px 0;font-weight:600;">$<%= load.declaredValue?.toLocaleString() || 'N/A' %></td>
                  </tr>
                </table>
              </td>
              <td width="2%"></td>
              <!-- CARRIER -->
              <% const carrierAssignment = load.carrierIds ? load.carrierIds : null; %>
              <td width="49%" valign="top" style="background:#ffffff;border:1px solid #e5e7eb;border-radius:16px;padding:10px 20px;">
                <div style="font-size:13px;font-weight:700;color:<%= brandColor %>;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:5px;">
                  Carrier Assignment
                </div>
                <table width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td style="padding:3px 0;color:#6b7280;font-weight:600;">Carrier</td>
                    <td align="right" style="padding:3px 0;font-weight:600;"><%= carrierAssignment?.carrier?.dba_name || carrierAssignment?.carrier?.companyId || 'N/A' %></td>
                  </tr>
                  <tr>
                    <td style="padding:3px 0;color:#6b7280;font-weight:600;">MC/DOT</td>
                    <td align="right" style="padding:3px 0;font-weight:600;"><%= carrierAssignment?.carrier?.mcNumber || carrierAssignment?.carrier?.usdot || 'N/A' %></td>
                  </tr>
                  <tr>
                    <td style="padding:3px 0;color:#6b7280;font-weight:600;">Power Unit</td>
                    <td align="right" style="padding:3px 0;font-weight:600;"><%= carrierAssignment?.powerunit || 'N/A' %></td>
                  </tr>
                  <tr>
                    <td style="padding:3px 0;color:#6b7280;font-weight:600;">Trailer</td>
                    <td align="right" style="padding:3px 0;font-weight:600;"><%= carrierAssignment?.trailer || 'N/A' %></td>
                  </tr>
                  <tr>
                    <td style="padding:3px 0;color:#6b7280;font-weight:600;">Dispatch Rate</td>
                    <td align="right" style="padding:3px 0;font-weight:600;">$<%= carrierAssignment?.carrierPay?.toLocaleString() || 'N/A' %></td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      <!-- DRIVERS -->
      <% if (carrierAssignment?.assignDrivers && carrierAssignment.assignDrivers.length) { %>
      <tr>
        <td style="padding:0 40px 30px 40px;">
          <div style="font-size:13px;font-weight:700;color:<%= brandColor %>;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:10px;">
            Assigned Drivers
          </div>
          <table width="100%" cellpadding="0" cellspacing="0">
            <% carrierAssignment.assignDrivers.forEach((driver, index) => { %>
            <tr>
              <td style="background:#fff7ed;border:1px solid #fed7aa;border-radius:16px;padding:10px 20px;margin-bottom:10px;">
                <table width="100%">
                  <tr>
                    <td width="25%">
                      <div style="font-size:13px;color:#92400e;font-weight:bold;">Driver Name</div>
                      <div style="margin-top:8px;font-size:15px;font-weight:600;"><%= driver?.driverName || 'N/A' %></div>
                    </td>
                    <td width="25%">
                      <div style="font-size:13px;color:#92400e;font-weight:bold;">Phone</div>
                      <div style="margin-top:8px;font-size:15px;font-weight:600;"><%= driver?.driverPhone || 'N/A' %></div>
                    </td>
                    <td width="25%">
                      <div style="font-size:13px;color:#92400e;font-weight:bold;">CDL Number</div>
                      <div style="margin-top:8px;font-size:15px;font-weight:600;"><%= driver?.driverCDL || 'N/A' %></div>
                    </td>
                    <td width="25%">
                      <div style="font-size:13px;color:#92400e;font-weight:bold;">CDL Expiration</div>
                      <div style="margin-top:8px;font-size:15px;font-weight:600;"><%= driver?.driverCDLExpiration ? formatDate(driver.driverCDLExpiration) : 'N/A' %></div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <% }); %>
          </table>
        </td>
      </tr>
      <% } %>
      <!-- PICKUP -->
      <% if (load.pickupLocationId && load.pickupLocationId.length > 0) { %>
      <tr>
        <td style="padding:0 40px 20px 40px;">
          <div style="font-size:13px;font-weight:700;color:<%= brandColor %>;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:10px;">
            Pickup Locations
          </div>
          <table width="100%" cellpadding="0" cellspacing="0">
            <% load.pickupLocationId.forEach((location, index) => { %>
            <tr>
              <td style="background:#ffffff;border:1px solid #e5e7eb;border-left:4px solid #10b981;border-radius:16px;padding:10px 15px;margin-bottom:10px;">
                <table width="100%">
                  <tr>
                    <td width="70%" valign="top">
                      <div style="font-size:15px;font-weight:700;color:#111827;">
                        <%= location.address || 'N/A' %>
                      </div>
                      <div style="margin-top:5px;font-size:14px;color:#6b7280;line-height:21px;">
                        <%= location.city || 'N/A' %>, <%= location.state || 'N/A' %> <%= location.zipcode || 'N/A' %><br>
                        Pickup Date: <%= location?.date?.toLocaleDateString() || 'N/A' %><br>
                        Pickup Time: <%= location?.time || 'N/A' %>
                      </div>
                    </td>
                    <td width="30%" align="right" valign="top">
                      <% if (location.requirements && location.requirements.length > 0) { %>
                        <% location.requirements.forEach(req => { %>
                          <span style="background:#eef2ff;color:#4338ca;padding:5px 14px;border-radius:30px;font-size:12px;font-weight:bold;display:inline-block;margin-bottom:5px;">
                          <%= req %>
                          </span>
                        <% }); %>
                      <% } %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <% }); %>
          </table>
        </td>
      </tr>
      <% } %>
      <!-- DELIVERY -->
      <% if (load.deliveryLocationId && load.deliveryLocationId.length > 0) { %>
      <tr>
        <td style="padding:0 40px 20px 40px;">
          <div style="font-size:13px;font-weight:700;color:<%= brandColor %>;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:10px;">
            Delivery Locations
          </div>
          <table width="100%" cellpadding="0" cellspacing="0">
            <% load.deliveryLocationId.forEach((location, index) => { %>
            <tr>
              <td style="background:#ffffff;border:1px solid #e5e7eb;border-left:4px solid <%= brandColor %>;border-radius:16px;padding:10px 15px;margin-bottom:10px;">
                <table width="100%">
                  <tr>
                    <td width="70%" valign="top">
                      <div style="font-size:15px;font-weight:700;color:#111827;">
                        <%= location.address || 'N/A' %>
                      </div>
                      <div style="margin-top:5px;font-size:14px;color:#6b7280;line-height:21px;">
                        <%= location.city || 'N/A' %>, <%= location.state || 'N/A' %> <%= location.zipcode || 'N/A' %><br>
                        Delivery Date: <%= location.date?.toLocaleDateString() || 'N/A' %><br>
                        Delivery Time: <%= location.time || 'N/A' %>
                      </div>
                    </td>
                    <td width="30%" align="right" valign="top">
                      <span style="background:#dcfce7;color:#166534;padding:5px 14px;border-radius:30px;font-size:12px;font-weight:bold;">
                      Delivered
                      </span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <% }); %>
          </table>
        </td>
      </tr>
      <% } %>
      <% } %>

      <!-- FREIGHT CHARGES -->
      <tr>
        <td style="padding:0 40px 20px 40px;">
          <div style="font-size:13px;font-weight:700;color:<%= brandColor %>;text-transform:uppercase;letter-spacing:0.5px;margin:10px 0px;">
            Freight Charges
          </div>
          <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;">
            <tr style="background:<%= brandColor %>;">
              <td style="padding:8px 15px;color:#ffffff;font-size:13px;font-weight:bold;">#</td>
              <td style="padding:8px 15px;color:#ffffff;font-size:13px;font-weight:bold;">
                Service
              </td>
              <td style="padding:8px 15px;color:#ffffff;font-size:13px;font-weight:bold;">
                Description
              </td>
              <td style="padding:8px 15px;color:#ffffff;font-size:13px;font-weight:bold;">
                Tax
              </td>
              <td align="center" style="padding:8px 15px;color:#ffffff;font-size:13px;font-weight:bold;">
                Qty
              </td>
              <td align="right" style="padding:8px 15px;color:#ffffff;font-size:13px;font-weight:bold;">
                Rate
              </td>
              <td align="right" style="padding:8px 15px;color:#ffffff;font-size:13px;font-weight:bold;">
                Amount
              </td>
            </tr>
            <% expense.forEach((item, index) => { %>
            <tr<%= index % 2 === 1 ? ' style="background:#f9fafb;"' : '' %>>
              <td style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:14px"><%= index + 1 %></td>
              <td style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-weight:600;font-size:14px">
                <%= item.productservice?.name || '-' %>
              </td>
              <td style="padding:10px 15px;border-bottom:1px solid #e5e7eb;color:#6b7280;font-size:14px">
                <%= item.description || '-' %>
              </td>
              <td style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:14px">
                <%= item.taxRate ? item.taxRate + '%' : 'N/A' %>
              </td>
              <td align="center" style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:14px">
                <%= item.qty || 1 %>
              </td>
              <td align="right" style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:14px">
                $<%= parseFloat(item.rate || 0).toFixed(2) %>
              </td>
              <td align="right" style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-weight:bold;font-size:14px">
                $<%= parseFloat(item.summary?.total || 0).toFixed(2) %>
              </td>
            </tr>
            <% }); %>
          </table>
        </td>
      </tr>
      <!-- NOTES + TOTALS -->
      <tr>
        <td style="padding:0 40px 40px 40px;">
          <table width="100%">
            <tr>
              <!-- NOTES -->
              <td width="58%" valign="top">
                <% if (invoice.customerNotes || invoice.terms_conditions) { %>
                <div style="font-size:12px;font-weight:700;color:<%= brandColor %>;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:8px;">
                  Notes & Terms
                </div>
                <div style="font-size:14px;line-height:21px;color:#4b5563;">
                  <% if (invoice.customerNotes) { %>
                    <%= invoice.customerNotes %><br>
                  <% } %>
                  <% if (invoice.terms_conditions) { %>
                    <%= invoice.terms_conditions %>
                  <% } %>
                </div>
                <% } %>
                <% if (invoice.paymentOptions) { %>
                <div style="font-size:12px;font-weight:700;color:<%= brandColor %>;text-transform:uppercase;letter-spacing:0.5px;margin-top:15px;margin-bottom:12px;">
                  Payment Options
                </div>
                <ul style="list-style:none;margin:0px;padding:0px;">
                  <li style="background:#eaeaea;padding:2px 10px;border-radius:30px;font-size:12px;font-weight:bold;display:inline-block;"><%= invoice.paymentOptions %></li>
                </ul>
                <% } %>
              </td>
              <!-- TOTALS -->
              <td width="42%" valign="top">
                <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e7eb;border-radius:16px;overflow:hidden;">
                  <tr>
                    <td style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:15px">
                      Subtotal
                    </td>
                    <td align="right" style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-weight:bold;font-size:15px">
                      $<%= subTotal.toFixed(2) %>
                    </td>
                  </tr>
                  <% if (taxAmount > 0) { %>
                  <tr>
                    <td style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:15px">
                      Tax
                    </td>
                    <td align="right" style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-weight:bold;font-size:15px">
                      $<%= taxAmount.toFixed(2) %>
                    </td>
                  </tr>
                  <% } %>
                  <% if (invoice.discountPercent && totalDiscount > 0) { %>
                  <tr>
                    <td style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:15px">
                      Discount
                    </td>
                    <td align="right" style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-weight:bold;font-size:15px">
                      <%= invoice.discountPercent %>%
                    </td>
                  </tr>
                  <% } %>
                  <tr style="background:#eaeaea;">
                    <td style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:15px;font-weight:bold">
                      Total
                    </td>
                    <td align="right" style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-weight:bold;font-size:15px">
                      $<%= total.toFixed(2) %>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:15px;">
                      Payment Received
                    </td>
                    <td align="right" style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-weight:bold;color:#15803d;font-size:15px">
                      $<%= recievedAmount.toFixed(2) %>
                    </td>
                  </tr>
                  <tr style="background:<%= brandColor %>;">
                    <td style="padding:5px 20px;color:#ffffff;font-size:16px;font-weight:600;">
                      Balance Due
                    </td>
                    <td align="right" style="padding:5px 20px;color:#ffffff;font-size:21px;font-weight:600;">
                      $<%= balanceDue.toFixed(2) %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      <!-- FOOTER -->
      <tr>
        <td style="background:#f8fafc;border-top:1px solid #e5e7eb;padding:15px 40px;">
          <table width="100%">
            <tr>
              <td style="font-size:13px;color:#9ca3af;">
                <%= invoice?.companyId?.label || 'FreightBooks Inc.' %>
              </td>
              <td align="center" style="font-size:13px;color:#9ca3af;">
                Thank you for your business!
              </td>
              <td align="right" style="font-size:13px;color:#9ca3af;">
                Invoice #<%= invoice.invoiceNumber %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>