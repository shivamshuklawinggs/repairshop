<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Load Details - <%= load.loadNumber %></title>
    <style>
        .page-break {
      page-break-before: always;
      break-before: page;
      height: 0;
      margin: 0;
    }
    .avoid-break {
      page-break-inside: avoid;
      break-inside: avoid;
    }
    * {
      box-sizing: border-box;
    }
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            margin: 0;
            padding: 20px;
            background-color: #f8f9fa;
        }
        .page {
            max-width: 1000px;
            margin: 0 auto;
            background: white;
            padding: 20px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            border-radius: 8px;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #1976d2;
        }
        .status-badge {
            padding: 6px 12px;
            border-radius: 4px;
            font-weight: bold;
            background-color: #e3f2fd;
            color: #1976d2;
        }
        .grid-container {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin-bottom: 20px;
        }
        .section {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 4px;
            border: 1px solid #dee2e6;
        }
        .section h3 {
            margin-top: 0;
            color: #1976d2;
            border-bottom: 1px solid #dee2e6;
            padding-bottom: 8px;
        }
        .info-grid {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 8px;
            align-items: center;
        }
        .label {
            font-weight: bold;
            color: #666;
        }
        .value {
            color: #333;
        }
        .location-card {
            background: white;
            padding: 12px;
            margin: 8px 0;
            border: 1px solid #dee2e6;
            border-radius: 4px;
        }
        .requirements-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 8px;
        }
        .requirement-tag {
            background: #e3f2fd;
            color: #1976d2;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.9em;
        }
        .carrier-section {
            background: #fff3e0;
            border: 1px solid #ffe0b2;
        }
        .driver-card {
            background: white;
            padding: 10px;
            margin: 5px 0;
            border: 1px solid #ffe0b2;
            border-radius: 4px;
        }
        @media print {
            body {
                background: white;
            }
            .page {
                box-shadow: none;
                max-width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="page">
        <div class="header">
            <div>
                <h1 style="margin: 0;">Load #<%= load.loadNumber %></h1>
                <p style="margin: 5px 0 0 0;">Created: <%= formatDate(new Date()) %></p>
            </div>
            <!-- <div class="status-badge">
                <%= load.status %>
            </div> -->
        </div>

        <div class="grid-container">
            <div class="section">
                <h3>Load Information</h3>
                <div class="info-grid">
                    <span class="label">Commodity:</span>
                    <span class="value"><%= load.commodity %></span>
                    
                    <span class="label">Equipment:</span>
                    <span class="value"><%= load.equipmentType %> - <%= load.equipmentLength %>'</span>
                    
                    <span class="label">Load Size:</span>
                    <span class="value"><%= load.loadSize %></span>
                    
                    <span class="label">Weight:</span>
                    <span class="value"><%= load.weight || 'N/A' %> lbs</span>
                    
                    <% if (load.temperature) { %>
                    <span class="label">Temperature:</span>
                    <span class="value"><%= load.temperature %>°<%= load.temperatureUnit %></span>
                    <% } %>
                    
                    <span class="label">Declared Value:</span>
                    <span class="value">$<%= load.declaredValue?.toLocaleString() || 'N/A' %></span>
                </div>
            </div>

            <% const carrierAssignment = (load.carrierIds ? load.carrierIds : null) %>

            <div class="section carrier-section">
                <h3>Carrier Assignment</h3>
                <div class="info-grid">
                    <span class="label">Carrier:</span>
                    <span class="value"><%= carrierAssignment?.carrier?.dba_name || carrierAssignment?.carrier?.company || 'N/A' %></span>
                    
                    <span class="label">MC/DOT:</span>
                    <span class="value"><%= carrierAssignment?.carrier?.mcNumber || carrierAssignment?.carrier?.usdot || 'N/A' %></span>
                    
                    <span class="label">Power Unit:</span>
                    <span class="value"><%= carrierAssignment?.powerunit || 'N/A' %></span>
                    
                    <span class="label">Trailer:</span>
                    <span class="value"><%= carrierAssignment?.trailer || 'N/A' %></span>
                    
                    <span class="label">Dispatch Rate:</span>
                    <span class="value">$<%= carrierAssignment?.carrierPay?.toLocaleString() || 'N/A' %></span>
                </div>
            
                <h4 style="margin: 15px 0 10px 0;">Assigned Drivers</h4>
                <% if (carrierAssignment?.assignDrivers && carrierAssignment.assignDrivers.length) { %>
                    <% carrierAssignment.assignDrivers.forEach((driver, index) => { %>
                        <div class="driver-card">
                            <div class="info-grid">
                                <span class="label">Name:</span>
                                <span class="value"><%= driver?.driverName || 'N/A' %></span>
                                
                                <span class="label">Phone:</span>
                                <span class="value"><%= driver?.driverPhone || 'N/A' %></span>
                                
                                <span class="label">CDL:</span>
                                <span class="value"><%= driver?.driverCDL || 'N/A' %></span>
                                
                                <span class="label">CDL Expiration:</span>
                                <span class="value"><%= driver?.driverCDLExpiration ?formatDate(driver.driverCDLExpiration) : 'N/A' %></span>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="driver-card">No drivers assigned</div>
                <% } %>
            </div>
            
        </div>

        <div class="section">
            <h3>Locations</h3>
            
            <h4 style="margin: 15px 0 10px 0;">Pickup Locations</h4>
            <% load.pickupLocationId?.forEach((location, index) => { %>
                <div class="location-card">
                    <div class="info-grid">
                        <span class="label">Address:</span>
                        <span class="value"><%= location.address || 'N/A' %></span>
                        <span class="label">City/State:</span>
                        <span class="value"><%= location.city || 'N/A' %>, <%= location.state || 'N/A' %> <%= location.zipcode || 'N/A' %></span>
                        <span class="label">Date/Time:</span>
                        <span class="value"><%= location?.date?.toLocaleDateString() || 'N/A' %> at <%= location?.time || 'N/A' %></span>
                    </div>
                    <% if (location.requirements && location.requirements.length > 0) { %>
                        <div class="requirements-list">
                            <% location.requirements?.forEach(req => { %>
                                <span class="requirement-tag"><%= req %></span>
                            <% }); %>
                        </div>
                    <% } %>
                    <% if (location.notes) { %>
                        <p style="margin: 8px 0 0 0; color: #666;"><strong>Notes:</strong> <%= location.notes %></p>
                    <% } %>
                </div>
            <% }); %>

            <h4 style="margin: 15px 0 10px 0;">Delivery Locations</h4>
            <% load.deliveryLocationId?.forEach((location, index) => { %>
                <div class="location-card">
                    <div class="info-grid">
                        <span class="label">Address:</span>
                        <span class="value"><%= location.address %></span>
                        <span class="label">City/State:</span>
                        <span class="value"><%= location.city %>, <%= location.state %> <%= location.zipcode %></span>
                        <span class="label">Date/Time:</span>
                        <span class="value"><%= location.date.toLocaleDateString() %> at <%= location.time %></span>
                    </div>
                    <% if (location.requirements && location.requirements.length > 0) { %>
                        <div class="requirements-list">
                            <% location.requirements?.forEach(req => { %>
                                <span class="requirement-tag"><%= req %></span>
                            <% }); %>
                        </div>
                    <% } %>
                    <% if (location.notes) { %>
                        <p style="margin: 8px 0 0 0; color: #666;"><strong>Notes:</strong> <%= location.notes %></p>
                    <% } %>
                </div>
            <% }); %>
        </div>


        <% if (load.notes) { %>
        <div class="section" style="margin-top: 20px;">
            <h3>Additional Notes</h3>
            <p style="margin: 0;"><%= load.notes %></p>
        </div>
        <% } %>
    </div>

</html>
