<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Invoice Update Notification</title>
</head>

<%
  const formatDate = (date) =>
    date ? new Date(date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : '-';

  const formatAmount = (value) =>
    typeof value === 'number'
      ? value.toLocaleString('en-IN', { style: 'currency', currency: 'INR' })
      : '-';

  const formatValue = (value) => {
    if (value === null || value === undefined) return '-';
    if (typeof value === 'boolean') return value ? 'Yes' : 'No';
    if (typeof value === 'object') {
      if (Array.isArray(value)) {
        if (value.length === 0) return 'None';
        if (value.length === 1) {
          const item = value[0];
          if (typeof item === 'object' && item !== null) {
            const desc = item.description || item.name || 'Item';
            const qty = item.qty !== undefined ? `Qty: ${item.qty}` : '';
            const rate = item.rate !== undefined ? `Rate: ${formatAmount(item.rate)}` : '';
            return `${desc}${qty ? ` (${qty})` : ''}${rate ? ` ${rate}` : ''}`;
          }
          return String(item);
        }
        return `${value.length} items`;
      } else {
        // Handle summary object specially
        if (value.subTotal !== undefined || value.finalAmount !== undefined) {
          const parts = [];
          if (value.subTotal !== undefined) parts.push(`Subtotal: ${formatAmount(value.subTotal)}`);
          if (value.discount !== undefined && value.discount > 0) parts.push(`Discount: ${formatAmount(value.discount)}`);
          if (value.finalAmount !== undefined) parts.push(`Total: ${formatAmount(value.finalAmount)}`);
          if (value.balanceDue !== undefined) parts.push(`Balance: ${formatAmount(value.balanceDue)}`);
          return parts.join('<br>');
        }
        // Generic object
        const keys = Object.keys(value);
        if (keys.length === 0) return '{}';
        return keys.slice(0, 3).map(key => `${key}: ${String(value[key])}`).join(', ') + (keys.length > 3 ? '...' : '');
      }
    }
    return String(value);
  };

  const formatFieldName = (fieldName) => {
    // Convert camelCase to readable format
    return fieldName
      .replace(/([A-Z])/g, ' $1')
      .replace(/^./, str => str.toUpperCase())
      .replace(/([A-Z])/g, ' $1')
      .trim();
  };

  const customerName = invoice?.customer?.displayCustomerName
    || invoice?.customer?.company
    || invoice?.customer?.nameToPrintOnCheck
    || invoice?.customerId?.displayCustomerName
    || invoice?.customerId?.company
    || invoice?.customerId?.nameToPrintOnCheck
    || 'Valued Customer';

  const companyName = invoice?.company?.label || invoice?.companyId?.label || 'FreightBooks';
  const companyPhone = invoice?.company?.phone || invoice?.companyId?.phone || '';
  const companyEmail = invoice?.company?.email || invoice?.companyId?.email || '';
  const companyAddress = invoice?.company?.address || invoice?.companyId?.address || '';
  const invoiceNumber = invoice?.invoiceNumber || '-';
  const totalAmount = invoice?.summary?.finalAmount ?? invoice?.summary?.subTotal ?? 0;
  const balanceDue = invoice?.summary?.balanceDue ?? 0;
  const updatedByName = updatedBy?.name || 'Unknown User';
  const updatedByEmail = updatedBy?.email || '';

  // Filter out system/internal fields from changes
  const displayChanges = actualChanges ? Object.keys(actualChanges).filter(key => 
    !['_id', '__v', 'createdAt', 'updatedAt'].includes(key)
  ).reduce((obj, key) => {
    obj[key] = actualChanges[key];
    return obj;
  }, {}) : {};
%>

<body style="margin:0;padding:25px 0px;background:#e5e5e5;font-family:Segoe UI,Arial,sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#e5e5e5;">
<tr>
<td align="center">

<!-- Main Container -->
<table width="600" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff;border-radius:10px;overflow:hidden;box-shadow:0 4px 6px rgba(0,0,0,0.1);">

<!-- Header -->
<tr>
<td align="center" style="background:#3d66f0;padding:30px 20px;color:#ffffff;">
<!-- Icon -->
<div style="margin-bottom:0px;">  	
<img src="https://api.freightbooks.net/uploads/email-icon.png" width="34" alt="Email Icon"> 		
</div>
<h2 style="margin:0;font-weight:500;font-size:22px;">Invoice Update Notification</h2>
<p style="margin:5px 0 0 0;font-size:14px;">Invoice #<%= invoiceNumber %> has been updated</p>
</td> 
</tr> 

<tr>
  <td style="padding:0;line-height:0;font-size:0;">    
    <img src="https://api.freightbooks.net/uploads/zigzag-divider.png" width="600" height="6" alt="zigzag-divider">	
  </td>
</tr> 

<tr>
  <td style="padding:30px 30px 10px 30px;">
    <table width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <!-- Left Side -->
        <td style="font-size:14px;color:#222;"> 
          Dear <strong><%= recipientName %></strong>,
        </td>

        <!-- Right Side -->
        <td align="right">
          <span style="display:inline-block; border:1px solid #ddd;padding:6px 10px;border-radius:5px;font-size:13px;">
            Invoice No: <strong>#<%= invoiceNumber %></strong>     
          </span>
        </td>
      </tr>
    </table>
  </td>
</tr>
 
<!-- Message Box -->
<tr>
<td style="padding:10px 30px;">
<table width="100%" cellpadding="0" cellspacing="0">
<tr>
<td style="background:#e0f2fe;border-left:3px solid #0284c7;padding:12px;font-size:14px; border-radius:5px;">
  Invoice #<%= invoiceNumber %> has been updated by <strong><%= updatedByName %></strong> (<%= updatedByEmail %>).
</td>

</tr>
</table>
</td>
</tr>

<!-- Changes Table -->
<% if (Object.keys(displayChanges).length > 0) { %>
<tr>
<td style="padding:10px 30px;">
<table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
<tr style="background:#fef3c7;font-weight:600;">
<td style="padding:10px;border-bottom:2px solid #f59e0b;">Field Changed</td>
<td style="padding:10px;border-bottom:2px solid #f59e0b;">Before</td>
<td style="padding:10px;border-bottom:2px solid #f59e0b;">After</td>
</tr>
<% Object.keys(displayChanges).forEach(function(key) { %>
<tr>
<td style="padding:8px;border-bottom:1px solid #e5e5e5;font-weight:500;"><%= formatFieldName(key) %></td>
<td style="padding:8px;border-bottom:1px solid #e5e5e5;color:#dc2626;"><%= formatValue(displayChanges[key].before) %></td>
<td style="padding:8px;border-bottom:1px solid #e5e5e5;color:#16a34a;font-weight:500;"><%= formatValue(displayChanges[key].after) %></td>
</tr>
<% }); %>
</table>
</td>
</tr>
<% } %>

<!-- Invoice Table -->
<tr>
<td style="padding:10px 30px 0 30px;">

<table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:14px;">

<tr style="background:#f0f0f0;font-weight:600;">
<td style="padding:8px;">Info</td>
<td style="padding:8px;">Detail</td>
</tr>

<tr>
<td style="padding:8px;border-bottom:1px solid #e5e5e5;">Invoice Number</td>
<td style="padding:8px;border-bottom:1px solid #e5e5e5;">#<%= invoiceNumber %></td>
</tr>

<tr>
<td style="padding:8px;border-bottom:1px solid #e5e5e5;">Customer</td>
<td style="padding:8px;border-bottom:1px solid #e5e5e5;"><%= customerName %></td>
</tr>

<tr>
<td style="padding:8px;border-bottom:1px solid #e5e5e5;">Invoice Date</td>
<td style="padding:8px;border-bottom:1px solid #e5e5e5;"><%= formatDate(invoice?.invoiceDate) %></td>
</tr>

<tr>
<td style="padding:8px;border-bottom:1px solid #e5e5e5;">Total Amount</td>
<td style="padding:8px;border-bottom:1px solid #e5e5e5;font-weight:600;"><%= formatAmount(totalAmount) %></td>
</tr>

<tr>
<td style="padding:8px;border-bottom:1px solid #e5e5e5;">Balance Due</td>
<td style="padding:8px;border-bottom:1px solid #e5e5e5;font-weight:700;color:#dc2626;"><%= formatAmount(balanceDue) %></td>
</tr>

<tr>
<td style="padding:8px;border-bottom:1px solid #e5e5e5;">Due Date</td>
<td style="padding:8px;border-bottom:1px solid #e5e5e5;"><%= formatDate(invoice?.dueDate) %></td>
</tr>

<tr>
<td style="padding:8px;border-bottom:1px solid #e5e5e5;">Status</td>
<td style="padding:8px;border-bottom:1px solid #e5e5e5;">
<span style="background:<%= statusBgColor %>;color:<%= statusColor %>;padding:2px 8px;border-radius:12px;font-size:12px;font-weight:600;">
<%= invoice?.paymentStatus || 'Pending' %>
</span>
</td>
</tr>

<tr>
<td style="padding:8px;">Last Updated</td>
<td style="padding:8px;"><%= formatDate(invoice?.updatedAt) %></td>
</tr>

</table>

</td>
</tr>

<!-- Note Box -->
<tr>
<td style="padding:10px 30px;">
<table width="100%">
<tr>
<td style="background:#f0f5fa;border-left:3px solid #667eea;padding:12px;font-size:14px;border-radius:5px;">
<strong>Note:</strong> Please review the updated invoice details. If you have any questions, contact the person who made this update.
</td>
</tr>

</table>
</td>
</tr>

<!-- Footer -->
<tr>
<td style="padding:10px 30px;font-size:14px;"> 
Thank you for your continued partnership with <strong><%= companyName %></strong>.<br><br>
Best regards,<br>
<strong><%= companyName %> Team</strong>
</td>
</tr>

<tr>
  <td style="padding:0px 30px 30px 30px;">
    <table width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <!-- Left Side -->
        <td style="font-size:14px;color:#444;">
		<% if (companyPhone) { %>Phone: <%= companyPhone %><br><% } %>
		<% if (companyEmail) { %>Email: <%= companyEmail %><% } %><br>
		<% if (companyAddress) { %><span style="display:inline-block;margin-top:6px;color:#555;">Address: <%= companyAddress %></span><% } %>
		</td>

        <!-- Right Side -->
        <td align="right">
		<a href="https://freightbooks.net/" target="_blank">
        <img src="<%= logoUrl %>" width="150" alt="FreightBooks"
            onerror="this.onerror=null; this.src='https://via.placeholder.com/150?text=FreightBooks';" />
		</a>
		</td>   
      </tr>
    </table> 
  </td>
</tr>

<!-- Logo -->
</table>

<!-- Bottom Note -->
<table width="600" cellpadding="0" cellspacing="0">
<tr>
<td align="center" style="font-size:13px;color:#555;padding:12px;">
This is an automated notification. Please do not reply to this email.
</td>
</tr>
</table>

</td>
</tr>
</table>

</body>
</html>
