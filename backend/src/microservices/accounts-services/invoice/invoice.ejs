<!DOCTYPE html> 
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>FreightBooks Invoice</title>
	<style>
@media print {
  /* Prevent table rows from splitting */
  tr,
  td,
  th {
    page-break-inside: avoid !important;
    break-inside: avoid !important;
  }

  /* Prevent important sections from breaking */
 .page-break-before {
    page-break-before: always !important; 
  }

  .no-page-break {
    page-break-inside: avoid !important;
    break-inside: avoid !important;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    page-break-inside: avoid !important;
  }

  /* Allow rows to move to next page instead of cutting */
  tr {
    page-break-inside: avoid;
    break-inside: avoid;
    page-break-after: auto;
  }

  img {
    page-break-inside: avoid;
    break-inside: avoid;
  }
}
</style>
  </head>
  <body style="margin:0;padding:0px;background:#fff;font-family:Segoe UI,Arial,sans-serif;color:#111827;font-size: 14px;">
    
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:1080px;margin:0 auto;background:#ffffff;border-radius:0px;overflow:hidden;border:1px solid #e5e7eb;padding:0px">
      
      <tr>
        <td style="height:5px;background:#003bff;"></td> 
      </tr>
      
      <tr>
        <td style="padding:20px 20px;background:#ffffff;"> 
          <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              
              <td valign="top">
                <div style="font-size:19px;font-weight:700;color:#003bff;">
                  <%= companyName %> 
                </div>
                <div style="margin-top:5px;font-size:13px;color:#6b7280;line-height:19px;">
                  <%= companyAddress %> <br>
                  <%= companyPhone %><br>
                  <%= companyEmail %>
                </div>
              </td>
              
              <td align="right" valign="top">
                <div style="font-size:27px;font-weight:700;color:#e0e7ff;letter-spacing:1px;text-transform:uppercase;">
                  Invoice
                </div>
                <div style="margin-top:5px;font-size:12.6px;color:#374151;line-height:21px;">
                  <strong>Invoice #:</strong> <%= invoiceNumber %><br>
                  <strong>Date:</strong>  <%= invoiceDate %><br>
                  <strong>Due Date:</strong> <%= dueDate %> <br>
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      
          <tr class="no-page-break">
        <td style="padding:10px 20px 30px 20px;background:#ffffff;">
          <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              
              <td width="50%" valign="top"
                style="
                background:#ffffff;
                border:1px solid #dbe4ff;
                border-left:4px solid #003bff;
                border-radius:15px;
                padding:15px 20px;
                ">
               
                <div style="
                  font-size:12.6px;
                  font-weight:700;
                  color:#003bff;
                  text-transform:uppercase;
                  letter-spacing:1px;
                  margin-bottom:7px;
                  ">
                  Bill To 
                </div>
                
                <div style="
                  font-size:14.4px;
                  font-weight:700;
                  color:#111827;
                  margin-bottom:5px;
                  line-height:1;
                  ">
                   <%= customerCompany || 'N/A' %>
                </div>
                
                <div style="
                  font-size:13px;
                  font-weight:600;
                  color:#6b7280;
                  line-height:20px;
                  ">
                  <%= customerAddress %> <br>
                  <%= customerCityState %><br>
                </div>
                <div style="
                  background:#eef2ff;
                  color:#003bff;
                  padding:5px 17px;
                  border-radius:30px;
                  font-size:14px;
                  font-weight:700;
                  display: block;
                  margin-top: 10px;
				  width: fit-content;
                  ">
                  Phone: <%= customerPhoneDisplay %>
                </div>
                <div style="
                  background:#f3f4f6;
                  color:#374151;
                  padding:5px 17px;
                  border-radius:30px;
                  font-size:13px;
                  font-weight:600;
                  display: block;
                  margin-top: 10px;
				  width: fit-content;
                  "> 
                  Email: <%= customerEmailDisplay %> 
                </div>
              </td>
              <td width="2%"></td>
              
              <td width="40%" valign="top"
                style="
                background:linear-gradient(135deg,#003bff 0%,#1d4ed8 100%);
                border-radius:15px;
                padding:15px;
                ">
                
                <div style="
                  font-size:12px;
                  font-weight:700;
                  color:#c7d2fe;
                  text-transform:uppercase;
                  letter-spacing:1px;
                  margin-bottom:10px;
                  ">
                  Payment Details 
                </div>
                
                <div style="
                  background:rgba(255,255,255,0.12);
                  border:1px solid rgba(255,255,255,0.15);
                  border-radius:14px;
                  padding:10px 15px;
                  ">
                  
                  <table width="100%" cellpadding="0" cellspacing="0">
                    <tr>
                      <td style="
                        padding:3px 0;
                        color:#c7d2fe;
                        font-size:13px;
                        font-weight:500;
                        ">
                        Payment Method :
                      </td>
                      <td align="right" style="
                        padding:3px 0;
                        color:#ffffff;
                        font-size:14px;
                        font-weight:500;
                        ">
                        <%= paymentMethod %>
                      </td>
                    </tr>
                    <tr>
                      <td style="
                        padding:3px 0;
                        color:#c7d2fe;
                        font-size:13px;
                        font-weight:500;
                        ">
                        Invoice Total :
                      </td>
                      <td align="right" style="
                        padding:3px 0;
                        color:#ffffff;
                        font-size:14px;
                        font-weight:500;
                        ">
                        $ <%= total %>
                      </td>
                    </tr>
                    <tr> 
                      <td style="
                        padding:3px 0;
                        color:#c7d2fe;
                        font-size:13px;
                        font-weight:500;
                        ">
                        Amount Paid :
                      </td>
                      <td align="right" style="
                        padding:3px 0;
                        color:#ffffff;
                        font-size:14px;
                        font-weight:500;
                        ">
                        $ <%= amountPaid %> 
                      </td> 
                    </tr>
                    <tr>
                      <td style="
                        padding:3px 0;
                        color:#c7d2fe;
                        font-size:13px;
                        font-weight:500;
                        ">
                        Balance Due :
                      </td>
                      <td align="right" style="
                        padding:3px 0;
                        color:#ffffff;
                        font-size:14px;
                        font-weight:500;
                        ">
                        $ <%= balanceDueDisplay %> 
                      </td>
                    </tr> 
                  </table> 
                </div>
              </td> 
            </tr>
          </table>
        </td>
      </tr>
      
   
     
      <tr class="no-page-break"> 
        <td style="padding:0 20px 20px 20px;">
          <div style="font-size:12px;font-weight:700;color:#003bff;text-transform:uppercase;letter-spacing:0.5px;margin:10px 0px;">
            Freight Charges
          </div>
          <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;">
            <tr style="background:#003bff;">
              <td style="padding:8px 15px;color:#ffffff;font-size:12px;font-weight:bold;">#</td>
              <td style="padding:8px 15px;color:#ffffff;font-size:12px;font-weight:bold;">
                Service
              </td>
              <td style="padding:8px 15px;color:#ffffff;font-size:12px;font-weight:bold;">
                Description
              </td>
              <td style="padding:8px 15px;color:#ffffff;font-size:12px;font-weight:bold;">
                Tax
              </td>
              <td align="center" style="padding:8px 15px;color:#ffffff;font-size:12px;font-weight:bold;">
                Qty
              </td>
              <td align="right" style="padding:8px 15px;color:#ffffff;font-size:12px;font-weight:bold;">
                Rate
              </td>
              <td align="right" style="padding:8px 15px;color:#ffffff;font-size:12px;font-weight:bold;">
                Amount
              </td>
            </tr>
             <% expense.forEach((item, index) => { %>
            <tr>
              <td style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:13px">1</td>
              <td style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-weight:600;font-size:13px">
                 <%= item.label || item.productservice?.name || '-' %>
              </td>
              <td style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:13px">
                <%= item.description || '-' %>
              </td>
              <td style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:13px">
                <%= item.tax ? `${item.tax.value}% ${item.tax.label}` : 'N/A' %>
              </td>
              <td align="center" style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:13px">
                <%= item.qty || 1 %>
              </td>
              <td align="right" style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:13px">
                $<%= parseFloat(item.rate || 0).toFixed(2) %>
              </td>
              <td align="right" style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-weight:bold;font-size:13px">
               $<%= parseFloat(item.summary?.total || 0).toFixed(2) %>
              </td>
            </tr>
             <% }); %>
          </table>
        </td>
      </tr>
      
      <tr>
        <td style="padding:0 20px 40px 20px;"> 
          <table width="100%">
            <tr>
              
              <td width="58%" valign="top">
                <% if (invoice.customerNotes || invoice.terms_conditions) { %> 
                <div style="font-size:12px;font-weight:700;color:#003bff;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:5px;">
                  Notes & Terms
                </div>
                <div style="font-size:13px;line-height:20px;color:#4b5563;">
                     <% if (invoice.customerNotes) { %>
                     <%= invoice.customerNotes %><br>
                     <% } %>
                     <% if (invoice.terms_conditions) { %>
                     <%= invoice.terms_conditions %>
                     <% } %>
                </div>
                <% } %>
                <div style="font-size:12px;font-weight:700;color:#003bff;text-transform:uppercase;letter-spacing:0.5px;margin-top:15px;margin-bottom:8px;">
                  Payment Options
                </div> 
                <ul style="list-style:none;margin:0px;padding:0px;">
                  <li style="background:#eaeaea;padding:2px 10px;border-radius:30px;font-size:12px;display:inline-block;">Cash</li>
                  <li style="background:#eaeaea;padding:2px 10px;border-radius:30px;font-size:12px;display:inline-block;">Credit Card</li>
                  <li style="background:#eaeaea;padding:2px 10px;border-radius:30px;font-size:12px;display:inline-block;">Check</li>
                </ul>
                <ul style="list-style:none;margin:8px 0 0 0;padding:0px;">
                  <li style="background:#eaeaea;padding:2px 10px;border-radius:30px;font-size:12px;display:inline-block;">Bank Transfer</li>
                  <li style="background:#eaeaea;padding:2px 10px;border-radius:30px;font-size:12px;display:inline-block;">Debit Card</li>
                  <li style="background:#eaeaea;padding:2px 10px;border-radius:30px;font-size:12px;display:inline-block;">Wire</li>
                </ul> 
              </td>
              
              <td width="42%" valign="top">
                <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e7eb;border-radius:16px;overflow:hidden;">
                  <tr>
                    <td style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:14px">
                      Subtotal
                    </td>
                    <td align="right" style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-weight:bold;font-size:14px">
                       $<%= subTotal.toFixed(2) %>
                    </td> 
                  </tr>
                  <tr>
                    <td style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:14px">
                      Tax
                    </td>
                    <td align="right" style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-weight:bold;font-size:14px">
                     $<%= taxAmount.toFixed(2) %>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:14px">
                      Discount
                    </td>
                    <td align="right" style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-weight:bold;font-size:14px">
                       <%= invoice.discountPercent %>%
                    </td>
                  </tr>
                  <tr style="background:#eaeaea;">
                    <td style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:14px;font-weight:bold">
                      Total
                    </td>
                    <td align="right" style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-weight:bold;font-size:14px">
                        $<%= total.toFixed(2) %>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-size:14px;">
                      Payment Received
                    </td>
                    <td align="right" style="padding:10px 15px;border-bottom:1px solid #e5e7eb;font-weight:bold;color:#15803d;font-size:14px">
                      $<%= amountPaid %>
                    </td>
                  </tr>
                  <tr style="background:#003bff;">
                    <td style="padding:5px 20px;color:#ffffff;font-size:14px;font-weight:600;">
                      Balance Due
                    </td>
                    <td align="right" style="padding:5px 20px;color:#ffffff;font-size:17px;font-weight:600;">
                      $<%= balanceDueDisplay %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      
      <tr>
        <td style="background:#f8fafc;border-top:1px solid #e5e7eb;padding:15px 20px;">
          <table width="100%">
            <tr>
              <td style="font-size:12px;color:#70757e;">
                <%= invoice?.companyId?.label || 'FreightBooks Inc.' %>
              </td>
              <td align="center" style="font-size:12px;color:#70757e;">
                Thank you for your business!
              </td>
              <td align="right" style="font-size:12px;color:#70757e;">
                   Invoice #<%= invoice.invoiceNumber %>
              </td>
            </tr>
          </table> 
        </td>
      </tr>
    </table>
  </body>
</html> 