<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Invoice</title>
    <style>
        :root {
            --primary-color: #1976d2;
            --border-color: #ddd;
            --text-color: #333;
            --background-color: #fff;
            --secondary-bg: #f8f9fa;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: Arial, sans-serif;
            color: var(--text-color);
            background: var(--background-color);
            padding: 20px;
            line-height: 1.4;
            font-size: 12px;
        }
        
        .page-break {
            page-break-before: always;
            break-before: page;
            height: 0;
            margin: 0;
        }
        
        .avoid-break {
            page-break-inside: avoid;
            break-inside: avoid;
        }
        
        .invoice-container {
            max-width: 800px;
            margin: 0 auto;
            background: var(--background-color);
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            padding: 30px;
        }
        
        .header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
            border-bottom: 2px solid var(--primary-color);
            padding-bottom: 15px;
        }
        
        .company-info h2 {
            color: var(--primary-color);
            margin-bottom: 8px;
            font-size: 18px;
        }
        
        .company-info p {
            font-size: 11px;
            line-height: 1.3;
            margin-bottom: 4px;
        }
        
        .invoice-info {
            text-align: right;
        }
        
        .invoice-info h1 {
            color: var(--primary-color);
            font-size: 24px;
            margin-bottom: 10px;
        }
        
        .invoice-info p {
            font-size: 11px;
            line-height: 1.3;
            margin-bottom: 4px;
        }
        
        .invoice-details {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
            gap: 30px;
        }
        
        .bill-to, .payment-info {
            flex: 1;
            background: var(--secondary-bg);
            padding: 15px;
            border-radius: 4px;
            font-size: 11px;
        }
        
        .bill-to h3, .payment-info h3 {
            color: var(--primary-color);
            margin-bottom: 10px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 5px;
            font-size: 14px;
        }
        
        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 25px;
            background: var(--background-color);
            font-size: 11px;
        }
        
        .items-table th {
            background: var(--primary-color);
            color: white;
            padding: 8px;
            text-align: left;
            font-size: 12px;
        }
        
        .items-table td {
            padding: 8px;
            border-bottom: 1px solid var(--border-color);
        }
        
        .items-table tr:nth-child(even) {
            background: var(--secondary-bg);
        }
        
        .totals {
            float: right;
            width: 300px;
            margin-bottom: 30px;
            font-size: 11px;
        }
        
        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            border-bottom: 1px solid var(--border-color);
        }
        
        .total-row.final {
            font-weight: bold;
            font-size: 13px;
            color: var(--primary-color);
            border-top: 2px solid var(--primary-color);
            border-bottom: 2px solid var(--primary-color);
            margin-top: 8px;
            padding: 8px 0;
        }
        
        .notes {
            clear: both;
            border-top: 1px solid var(--border-color);
            padding-top: 15px;
            font-size: 11px;
        }
        
        .notes h3 {
            color: var(--primary-color);
            margin-bottom: 8px;
            font-size: 13px;
        }
        
        .footer {
            text-align: center;
            margin-top: 30px;
            padding-top: 15px;
            border-top: 1px solid var(--border-color);
            color: #666;
            font-size: 10px;
        }

        @media print {
            body {
                padding: 0;
                background: none;
            }
            
            .invoice-container {
                box-shadow: none;
                padding: 15px;
                max-width: none;
            }
            
            .items-table th {
                background-color: #eee !important;
                color: var(--text-color) !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            
            .bill-to, .payment-info, .load-details {
                background: none;
                border: 1px solid var(--border-color);
            }
            
            .total-row.final {
                border-color: var(--text-color);
                color: var(--text-color);
            }
        }
    </style>
</head>
<body>