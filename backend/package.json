{
  "name": "node-api-demo",
  "version": "1.0.0",
  "description": "Transport Service Accounting System API",
  "main": "src/server.ts",
  "scripts": {
    "dev": "nodemon ",
    "build": "tsc && tsc-alias && npm run copy:assets && npm run copy:configs && npm run copy:project-overview",
    "copy:assets": "cpx \"src/**/*.ejs\" dist/",
    "copy:configs": "cpx \"src/microservices/**/config.json\" dist/microservices",
    "copy:project-overview": "cpx \"src/microservices/**/freightbooks-data.json\" dist/microservices",
    "start": "npm i && npm run build && pm2 start dist/server.js --name api.freightbooks.com",
    "start:dev": "cross-env NODE_ENV=development npm run build && cross-env NODE_ENV=development node dist/server.js",
    "dev:staging": "nodemon cross-env NODE_ENV=staging ts-node -r tsconfig-paths/register ./src/server.ts cross-env NODE_ENV=staging",
    "stop": "pm2 stop dist/server.js",
    "start:pm2": "npm run build && pm2 start dist/server.js  --name api.freightbooks.com && sudo env PATH=$PATH:/usr/bin pm2 startup systemd -u root --hp /root && pm2 save",
    "restart:pm2": "npm i && npm run build && pm2 restart dist/server.js --name api.freightbooks.com",
    "restartwi:pm2": "npm run build && pm2 restart dist/server.js --name api.freightbooks.com",
    "start:pm2:staging": "npm i && npm run build && pm2 start dist/server.js --name staging.api.freightbooks.com && sudo env PATH=$PATH:/usr/bin pm2 startup systemd -u root --hp /root && pm2 save",
    "restart:pm2:staging": "npm i && npm run build && pm2 restart dist/server.js --name staging.api.freightbooks.com",
    "log:pm2": "pm2 logs",
    "type-check:watch": "tsc --noEmit --watch",
    "clean-db": "ts-node src/scripts/clean-db.ts"
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "axios": "^1.8.1",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "csv-parse": "^6.1.0",
    "docx": "^8.5.0",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.1",
    "helmet": "^7.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.1",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.2",
    "mongodb": "^6.20.0",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.3",
    "openai": "^6.6.0",
    "pdf-node": "^1.5.0",
    "puppeteer": "^24.5.0",
    "redis": "^5.8.2",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^3.7.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "validator": "^13.12.0",
    "winston": "^3.17.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.13",
    "@types/crypto-js": "^4.2.2",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.17",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-session": "^1.18.1",
    "@types/jest": "^29.5.4",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/lodash": "^4.17.24",
    "@types/morgan": "^1.9.5",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.5.7",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/puppeteer": "^5.4.7",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.12.2",
    "cpx": "^1.2.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.0.1",
    "pm2": "^6.0.13",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.11",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  }
}
